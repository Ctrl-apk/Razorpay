# ─────────────────────────────────────────────────
# AI Incident Investigator — environment template
# Copy to .env and fill in values
# ─────────────────────────────────────────────────

# Database (SQLite by default — no setup required)
# For production use PostgreSQL:
# DATABASE_URL=postgresql://user:password@localhost:5432/incident_investigator
DATABASE_URL=sqlite:///./incident_investigator.db

# AI Provider: stub | openai | anthropic
# stub works without any API key (recommended for demo)
AI_PROVIDER=stub
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# GitHub (optional — for future deployment correlation)
RAZORPAY_WEBHOOK_SECRET=

# Application
DEBUG=false
DEMO_MODE=true
LOG_LEVEL=INFO
SECRET_KEY=change-this-in-production
